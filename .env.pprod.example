# Pre-Production Environment

# App Port
PORT=3000

# Node Environment
NODE_ENV=pprod

# MongoDB Configuration
MONGO_URI=mongodb+srv://your_username:your_password@your_cluster.mongodb.net/si_pprod_db

# PostgreSQL Configuration
DB_USER=postgres
DB_PASSWORD=your_password
DB_HOST=your-pprod-db-host.rds.amazonaws.com
DB_NAME=si_pprod_db

# App Secrets
JWT_SECRET=your_pprod_jwt_secret
SESSION_SECRET=your_pprod_session_secret
